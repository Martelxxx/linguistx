# DEVNOTE: Names only; never commit real credentials. Production secrets belong in the deployment secret manager.
# v84 LOCAL DEVELOPMENT ONLY. Keys persist at ~/.linguist-x/provider_keys.env across release folders.
# python3 start.py asks privately ONLY if a provider remains unconfigured.
# To rotate previously saved keys: python3 start.py --configure
# Optional backward compatibility: existing .env keys migrate on first local start.
# Keep all actual credentials out of distributable source control.
# Existing optional flight data / sample audio / weather services are independent:
AVIATIONSTACK_KEY=
OPENAI_API_KEY=
WEATHERAPI_KEY=

# AV-ation CONTROLLED guest gateway; NOT an undocumented Wordly REST URL.
# Must be HTTPS, except http://127.0.0.1 for a local contract-test stub.
LX_GATEWAY_URL=
LX_GATEWAY_TOKEN=
# Optional: override local testing port
# PORT=8765

# Optional explicit local fixture (not Wordly integration):
# LX_ENABLE_FIXTURE=1 LX_NO_SETUP=1 python3 run.py
# Fixture must not run in LX_LAN=1.

# LX_ENV=development|test|production (production requires ASGI and LX_NO_SETUP=1)

# For future multi-instance production gateway, inject via secret manager:
# LX_REDIS_URL=rediss://...
# LX_REDIS_PREFIX=passenger
# LX_PUBLIC_URL=https://your-approved-origin.example
